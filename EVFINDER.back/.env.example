# Copie este arquivo para .env e preencha com seus valores.
# O .env está no .gitignore e nunca deve ser commitado.

# Chave da API do Open Charge Map: https://openchargemap.org/site/develop/api
OCM_API_KEY=sua-chave-aqui

# Opcional: porta do PostgreSQL no seu computador (padrão 5432).
# Use outra (ex.: 5433) se você já tem um PostgreSQL instalado ocupando a 5432.
# Vale para o docker-compose.yml e para a aplicação ao mesmo tempo.
# DB_PORT=5433
